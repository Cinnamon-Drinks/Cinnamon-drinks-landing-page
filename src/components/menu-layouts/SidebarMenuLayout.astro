---
// src/components/menu-layouts/SidebarMenuLayout.astro
// Estilo "Menu 1" do template Webflow: sidebar fixa de abas (uma por bar da
// combinação) com preenchimento em gradiente ao ativar/hover, lista de
// drinks em texto e foto do bar em painel fixo à direita (borda branca,
// cantos arredondados — classe .border do global.css). Troca de aba usa o
// widget nativo de Tabs do Webflow (w-tabs/w-tab-link/w-tab-pane), já
// embutido em public/webflow.js — sem JS próprio.
import type { CollectionEntry } from 'astro:content';
import { renderInlineBold } from '../../scripts/inline-markup';

interface Combination {
  label: string;
  description?: string;
  note?: string;
  price?: string;
  image?: { src: string; alt: string } | null;
  drinks: CollectionEntry<'drinks'>[];
}

interface Props {
  combinations: Combination[];
}

const { combinations } = Astro.props;
---

<div
  data-current="Tab 1"
  data-easing="ease"
  data-duration-in="300"
  data-duration-out="100"
  class="flex-container w-tabs"
>
  <div class="sidebar-menu-tabs w-tab-menu">
    {
      combinations.map((combo, i) => (
        <a
          data-w-tab={`Tab ${i + 1}`}
          class={`menu-tab w-inline-block w-tab-link${i === 0 ? ' w--current' : ''}`}
        >
          <div class="menu-text">{combo.label}</div>
          {combo.price && <div class="menu-tab-price">{combo.price}</div>}
          <div class="tab-bg menu-1" />
        </a>
      ))
    }
  </div>
  <div class="tabs-content w-tab-content">
    {
      combinations.map((combo, i) => {
        // Painel lateral: imagem própria da aba (override do admin) ou, sem
        // ela, a foto do 1º drink curado — garante que o painel nunca fica
        // vazio e que o <img> existe pro menu-drink-image.ts trocar no clique.
        const firstDrink = combo.drinks[0];
        const photo =
          combo.image ??
          (firstDrink?.data.image
            ? { src: firstDrink.data.image, alt: firstDrink.data.name }
            : null);
        return (
          <div data-w-tab={`Tab ${i + 1}`} class={`w-tab-pane${i === 0 ? ' w--tab-active' : ''}`}>
            <div class="tabs-content-wrapper">
              <div class="menu-items-list">
                {combo.description && <p class="menu-tab-description">{combo.description}</p>}
                {combo.note && (
                  <p class="menu-tab-note" set:html={renderInlineBold(combo.note)} />
                )}
                {combo.drinks.length > 0 ? (
                  combo.drinks.map((drink) => (
                    <button
                      type="button"
                      class="collection-item-2"
                      data-drink-image={drink.data.image}
                      data-drink-name={drink.data.name}
                    >
                      <p class="menu-1-name">{drink.data.name}</p>
                      <p class="menu-1-descript">{drink.data.ingredients.join(', ')}</p>
                    </button>
                  ))
                ) : (
                  <div class="collection-item-2">
                    <p class="menu-1-descript">Em breve</p>
                  </div>
                )}
              </div>
              <div class="menu-1-img border">
                {photo && <img src={photo.src} alt={photo.alt} loading="lazy" class="cover-image" />}
                <div class="text-holder tablet-gradient">
                  <p class="menu-1-title heading-3">{combo.label}</p>
                </div>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
  <div class="menu-border border" />
</div>

<script>
  import '../../scripts/menu-drink-image.ts';
</script>

<style>
  /* .menu-tabs original do global.css é usada (com ID diferente) pelas
   * sections #menu/#estrutura da home, que sobrescrevem .menu-tabs.w-tab-menu
   * (position:static, flex-direction:row) sem escopo — colidiria com esta
   * página. Classe própria replicando os valores originais do template,
   * mas com "top" ajustado pra não ficar embaixo da navbar fixa (que o
   * template original, sendo multi-página sem navbar sticky do mesmo jeito,
   * não precisava considerar). */
  .sidebar-menu-tabs {
    z-index: 5;
    grid-row-gap: 0.2em;
    flex-direction: column;
    justify-content: flex-start;
    width: 25vw;
    padding-top: 2rem;
    display: flex;
    position: fixed;
    top: 10rem;
  }
  @media screen and (max-width: 991px) {
    .sidebar-menu-tabs {
      background-color: var(--brand-white);
      border-radius: 2.5em;
      flex-direction: row;
      justify-content: space-between;
      width: 95vw;
      height: auto;
      margin-bottom: 1em;
      margin-left: auto;
      margin-right: auto;
      padding: 0.3em;
      position: fixed;
      top: auto;
      inset: auto 0% 0%;
    }
  }

  /* .menu-tab herda font-size:1.78em + padding-left:8.33vw do global.css,
   * calibrados pra sidebar vertical desktop com palavras curtas em inglês
   * ("main", "drink"...). Nomes de bar em português são mais longos e
   * estouravam o overflow:hidden da aba (necessário pro preenchimento em
   * gradiente não vazar) — reduzido só no desktop. */
  @media screen and (min-width: 992px) {
    .menu-tab {
      font-size: 1.3em;
      padding-left: 6.5vw;
    }
  }
  /* Mobile: a aba vira um item dentro da barra pill horizontal — o
   * padding-left do desktop (pensado pra sidebar vertical) não faz
   * sentido aqui e desalinhava o texto dentro do espaço de cada aba.
   * flex:1 + texto centralizado distribui as 5 abas igualmente na barra. */
  @media screen and (max-width: 991px) {
    .menu-tab {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0.55em 0.4em;
      font-size: 0.92em;
    }
  }

  /* .menu-1-title herda .heading-3 (font-size:6.2em a 991px, 9.5em a
   * 479px — calibrado pra "MAIN"/"SIDES" curtos, especificidade (0,2,0)
   * igual à combinação .menu-1-title.heading-3 do global.css). Precisa de
   * um ancestral no seletor pra ganhar a cascata sem !important. Nomes de
   * bar mais longos estouravam a largura da tela nesse tamanho. */
  @media screen and (max-width: 991px) {
    .text-holder .menu-1-title {
      font-size: 2.6rem;
    }
  }

  /* Preço abaixo do nome de cada aba na sidebar (todas as 4 abas mostram
   * preço ao mesmo tempo, editável via CMS em combinations[].price).
   * .menu-tab:has(.menu-tab-price) força column só quando há preço — no
   * mobile .menu-tab é flex-row (abas lado a lado na barra), então sem
   * isso o preço ficava colado no nome na mesma linha ("STANDARDR$..."). */
  .menu-tab-price {
    display: block;
    width: 100%;
    font-size: 0.42em;
    font-weight: 400;
    opacity: 0.85;
    margin-top: 0.2em;
  }
  @media screen and (max-width: 991px) {
    .menu-tab:has(.menu-tab-price) {
      flex-direction: column;
    }
    .menu-tab-price {
      font-size: 0.8em;
      margin-top: 0.2em;
    }
  }

  /* Cada drink real vira <button> (clicável/focável) pra trocar a foto do
   * painel fixo ao lado — menu-drink-image.ts faz a troca em runtime.
   * Reset de estilos padrão de <button> pra ficar idêntico ao <div> que
   * era antes; :focus-visible fica no default do browser (não removido)
   * pra não perder o indicador de foco no teclado. O placeholder "Em
   * breve" continua <div>, sem nada disso, porque não é clicável. */
  .collection-item-2 {
    display: block;
    width: 100%;
    background: none;
    border: none;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .collection-item-2:hover .menu-1-name,
  .collection-item-2.is-selected .menu-1-name {
    color: var(--accent);
  }
</style>

