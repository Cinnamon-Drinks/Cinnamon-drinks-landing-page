---
// src/pages/menu/[package].astro
import { getCollection, getEntry } from 'astro:content';
import SidebarMenuLayout from '../../components/menu-layouts/SidebarMenuLayout.astro';
import StructureLayout from '../../components/menu-layouts/StructureLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const LEGACY_CLIENT_NAME = 'Cliente não informado';
  const slugifyMenuSegment = (value: string) =>
    value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');

  const getOrcamentoClientSlug = (pkg: { id: string; data: { clientName?: string } }) => {
    const clientName = pkg.data.clientName?.trim();

    if (!clientName || clientName === LEGACY_CLIENT_NAME) {
      return pkg.id;
    }

    return slugifyMenuSegment(clientName) || pkg.id;
  };

  const [fixos, orcamentos] = await Promise.all([
    getCollection('menuPackages'),
    getCollection('orcamentos')
  ]);

  const fixedPaths = fixos.map((pkg) => ({
    params: { package: pkg.id },
    props: { pkg }
  }));

  const orcamentoPaths = orcamentos.flatMap((pkg) => {
    const clientSlug = getOrcamentoClientSlug(pkg);
    const paths = [
      {
        params: { package: clientSlug },
        props: { pkg }
      }
    ];

    if (clientSlug !== pkg.id) {
      paths.push({
        params: { package: pkg.id },
        props: { pkg }
      });
    }

    return paths;
  });

  return [...fixedPaths, ...orcamentoPaths];
}

const { pkg } = Astro.props;
// Orçamentos saem do índice de busca (link não-listado); os 3 fixos ficam indexáveis.
const noindex = pkg.collection === 'orcamentos';
const clientName = noindex ? pkg.data.clientName?.trim() : '';
const pageName = clientName ? `${pkg.data.name} — ${clientName}` : pkg.data.name;

// A variante "menu" resolve os drinks curados de cada aba; "structure" usa
// rótulos livres (labels) e é renderizada pelo StructureLayout.
const combinations =
  pkg.data.type === 'menu'
    ? await Promise.all(
        pkg.data.combinations.map(async (combination) => ({
          label: combination.label,
          description: combination.description,
          note: combination.note,
          price: combination.price,
          image: combination.image,
          drinks: combination.drinks?.length
            ? await Promise.all(combination.drinks.map((ref) => getEntry(ref)))
            : []
        }))
      )
    : [];
---

<Base title={`${pageName} — Cardápio`} description={`Combinações do ${pageName}.`} noindex={noindex}>
  <Navbar hideBottomCta />
  <h1 class="sr-only">{pageName}</h1>
  {pkg.data.type === 'structure' && <StructureLayout labels={pkg.data.labels} />}
  {pkg.data.type === 'menu' && <SidebarMenuLayout combinations={combinations} />}
</Base>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
