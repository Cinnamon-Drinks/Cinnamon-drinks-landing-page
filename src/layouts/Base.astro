---
// src/layouts/Base.astro
import '../styles/normalize.css';
import '../styles/webflow.css';
import '../styles/global.css';
import '../styles/new-sections.css';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const site = await getEntry('site', 'site');
const { title, description, ogImage = '/og-image.jpg', noindex = false } = Astro.props;
const siteUrl = Astro.site ?? new URL('https://cinnamondrinks.com.br');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const resolvedOgImage = new URL(ogImage, siteUrl).toString();
const logoUrl = new URL('/images/site-icon-512.png', siteUrl).toString();

const pageTitle = title
  ? `${title} — ${site!.data.brandName}`
  : `${site!.data.brandName} — ${site!.data.tagline}`;

const pageDesc =
  description ??
  'Coquetelaria de alto padrão para casamentos, formaturas e eventos em Lavras/MG. Solicite seu orçamento.';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site!.data.brandName,
  description: pageDesc,
  url: siteUrl.toString(),
  logo: logoUrl,
  image: resolvedOgImage,
  telephone: `+${site!.data.whatsappNumber}`,
  email: site!.data.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site!.data.address,
    addressLocality: 'Lavras',
    addressRegion: 'MG',
    addressCountry: 'BR'
  },
  sameAs: [`https://instagram.com/${site!.data.instagram}`]
};
---

<!doctype html>
<html
  lang="pt-BR"
  data-wf-page="69f4c8d1d03a897fbae58d03"
  data-wf-site="69f4c8d0d03a897fbae58cb2"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site!.data.brandName} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="theme-color" content="#000000" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="48x48" href="/images/favicon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100;400;500;600;700&display=swap"
    />
    <script is:inline>
      // Webflow IX2 prerequisite: define classes w-mod-js (+ w-mod-touch
      // se touch device). Os seletores em webflow-ix2-init.css usam
      // html.w-mod-js:not(.w-mod-ix) para aplicar transforms iniciais
      // ANTES do webflow.js carregar e ativar IX2 (que adiciona w-mod-ix).
      !(function (o, c) {
        var n = c.documentElement,
          t = ' w-mod-';
        n.className += t + 'js';
        if ('ontouchstart' in o || (o.DocumentTouch && c instanceof DocumentTouch))
          n.className += t + 'touch';
      })(window, document);
    </script>
    <script is:inline src="/vendor/jquery-3.5.1.min.js"></script>
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
    <script is:inline src="/webflow.js"></script>
  </body>
</html>
